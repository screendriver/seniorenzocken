{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>enormora/renovate-config#1.0.4", "github>enormora/renovate-config:renovate-automerge#1.0.4"],
	"automergeStrategy": "auto",
	"commitMessagePrefix": "",
	"dependencyDashboard": true,
	"packageRules": [
		{
			"groupName": "Vite dependencies",
			"groupSlug": "vite",
			"matchPackageNames": ["vite", "@tailwindcss/vite"]
		},
		{
			"groupName": "Test tooling",
			"groupSlug": "test-tooling",
			"matchPackageNames": ["mocha", "@types/mocha", "sinon", "@types/sinon", "eslint-plugin-mocha"]
		},
		{
			"groupName": "React dependencies",
			"groupSlug": "react",
			"matchPackageNames": [
				"react",
				"react-dom",
				"react-router-dom",
				"@types/react",
				"@types/react-dom",
				"@vitejs/plugin-react",
				"@testing-library/react",
				"@testing-library/user-event",
				"@radix-ui/*"
			]
		},
		{
			"groupName": "tRPC dependencies",
			"groupSlug": "trpc",
			"matchPackageNames": ["@trpc/*", "@hono/trpc-server"]
		},
		{
			"matchPackageNames": ["@sentry/*"],
			"groupName": "sentry packages"
		},
		{
			"matchPackageNames": ["@tanstack/*"],
			"groupName": "tanstack packages"
		},
		{
			"groupName": "Node.js",
			"groupSlug": "nodejs",
			"matchPackageNames": ["node", "public.ecr.aws/docker/library/node"],
			"automerge": false
		}
	]
}
